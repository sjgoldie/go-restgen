meta {
  name: Posts - Editor Without Blog Ownership Gets 404 Under the Blog
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/blogs/{{aliceBlogId}}/posts/{{alicePostId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: user:bob:user
}

assert {
  res.status: eq 404
}

docs {
  # Nested Posts Require Owning the Blog
  Bob is the post's editor, but he does not own Alice's blog. Blogs require ownership,
  so posts nested under a blog are only reachable by the blog's owner (Issue #28).
  Editors reach their posts through the root /posts route instead (see 54-57).
}
