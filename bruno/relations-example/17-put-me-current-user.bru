meta {
  name: PUT /me - current user by external ID
  type: http
  seq: 17
}

put {
  url: {{baseUrl}}/me
  body: json
  auth: bearer
}

auth:bearer {
  token: user:alice:user
}

body:json {
  {
    "name": "Alice Updated",
    "email": "alice-updated@example.com",
    "external_id": "alice"
  }
}

assert {
  res.status: eq 200
  res.body.id: eq {{aliceUserId}}
  res.body.name: eq Alice Updated
  res.body.email: eq alice-updated@example.com
}

docs {
  # Update the Current User via PUT /me

  The update targets the caller's own user, and ExternalID is always written from the auth
  user ID, so the caller cannot change it.
}
