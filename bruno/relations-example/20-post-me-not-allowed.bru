meta {
  name: POST /me not allowed
  type: http
  seq: 20
}

post {
  url: {{baseUrl}}/me
  body: json
  auth: bearer
}

auth:bearer {
  token: user:alice:user
}

body:json {
  {
    "name": "New User",
    "email": "new@example.com",
    "external_id": "new"
  }
}

assert {
  res.status: eq 405
}

docs {
  # No Collection Routes on the Current User

  AsCurrentUser mounts only the item routes at /me, so there is no create.
  POST returns 405 Method Not Allowed.
}
