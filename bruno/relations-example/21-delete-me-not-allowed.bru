meta {
  name: DELETE /me not allowed
  type: http
  seq: 21
}

delete {
  url: {{baseUrl}}/me
  body: none
  auth: bearer
}

auth:bearer {
  token: user:alice:user
}

assert {
  res.status: eq 401
}

docs {
  # Methods Without an Auth Config Are Blocked

  AsCurrentUser mounts the item routes at /me, including DELETE. The route's auth config only
  lists GET and PUT, so DELETE is blocked like any unconfigured method.
}
