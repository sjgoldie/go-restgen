meta {
  name: Security - Include Count with Ownership
  type: http
  seq: 35
}

get {
  url: {{baseUrl}}/posts?include_count=Comments
  body: none
  auth: bearer
}

auth:bearer {
  token: user:alice:user
}

assert {
  res.status: eq 200
  res.body.data: isArray
  res.body.counts: isDefined
  res.body.counts.Comments: isDefined
}

tests {
  test("Only Alice's posts returned (ownership enforced)", function() {
    expect(res.body.data.every(p => p.owner_id === "alice")).to.be.true;
  });

  test("Counts only include comments Alice can see", function() {
    const counts = res.body.counts.Comments;
    const alicePostId = String(bru.getVar("alicePostId"));
    // Her post has two comments: her own and one the admin added.
    // Comments are ownership-scoped, so she counts only her own.
    expect(counts[alicePostId]).to.equal(1);

    const bobPostId = String(bru.getVar("bobPostId"));
    expect(counts[bobPostId]).to.be.undefined;
  });
}

docs {
  Alice requests include_count=Comments. Ownership enforced at both levels:
  Only her posts are returned, and each count covers only the comments she
  could list with ?include=Comments. The admin's comment on her post and
  Bob's post are not leaked through the count.
}
