meta {
  name: GET /posts/{id}/author/posts - another author's posts as admin
  type: http
  seq: 42
}

get {
  url: {{baseUrl}}/posts/{{bobPostId}}/author/posts
  body: none
  auth: bearer
}

auth:bearer {
  token: user:admin:user,admin
}

assert {
  res.status: eq 200
  res.body.data: isArray
}

tests {
  test("Every post is by Bob, the post's author", function() {
    expect(res.body.data.length).to.be.above(0);
    expect(res.body.data.every(p => p.author_id === bru.getVar("bobUserId"))).to.equal(true);
  });
}
