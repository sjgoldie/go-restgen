meta {
  name: Create EMEA Project - Global Writer
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/projects
  body: json
  auth: none
}

headers {
  X-User: admin
  X-Scopes: project:write,task:write
}

body:json {
  {
    "region": "emea",
    "name": "Apollo"
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
  res.body.region: eq emea
}

script:post-response {
  bru.setVar("apolloId", res.body.id);
}

docs {
  # Global Scope Is Unrestricted
  A caller holding project:write in X-Scopes can write to any region.
}
