meta {
  name: Create APAC Project - Global Writer
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/projects
  body: json
  auth: none
}

headers {
  X-User: admin
  X-Scopes: project:write,task:write
}

body:json {
  {
    "region": "apac",
    "name": "Borealis"
  }
}

assert {
  res.status: eq 201
  res.body.region: eq apac
}

script:post-response {
  bru.setVar("borealisId", res.body.id);
}
