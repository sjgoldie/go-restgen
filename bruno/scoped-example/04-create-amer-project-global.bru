meta {
  name: Create AMER Project - Global Writer
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/projects
  body: json
  auth: none
}

headers {
  X-User: admin
  X-Scopes: project:write
}

body:json {
  {
    "region": "amer",
    "name": "Cygnus"
  }
}

assert {
  res.status: eq 201
  res.body.region: eq amer
}
