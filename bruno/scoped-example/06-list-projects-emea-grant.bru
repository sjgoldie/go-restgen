meta {
  name: List Projects - EMEA Grant Sees EMEA Only
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/projects?count=true
  body: none
  auth: none
}

headers {
  X-User: alice
  X-Grants: project:read@region=emea
}

assert {
  res.status: eq 200
  res.body.data: isArray
}

tests {
  test("Scoped grant narrows the list and the total count", function() {
    expect(res.body.data.length).to.equal(1);
    expect(res.body.data[0].region).to.equal("emea");
    expect(res.body.pagination.total_count).to.equal(1);
  });
}

docs {
  # Scoped Grant
  Alice has project:read only in the EMEA region, so the list, and its total_count,
  contain EMEA projects only.
}
