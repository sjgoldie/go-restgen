meta {
  name: Create Task Under EMEA Project
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/projects/{{apolloId}}/tasks
  body: json
  auth: none
}

headers {
  X-User: alice
  X-Grants: task:write@region=emea
}

body:json {
  {
    "title": "Kick-off"
  }
}

assert {
  res.status: eq 201
}

tests {
  test("Task is created under the EMEA project", function() {
    expect(res.body.project_id).to.equal(bru.getVar("apolloId"));
  });
}

docs {
  # Children Inherit the Partition
  Tasks have no region field; a task is in EMEA because its project is.
}
