meta {
  name: List Tasks Under APAC Project - EMEA Reader Sees None
  type: http
  seq: 16
}

get {
  url: {{baseUrl}}/projects/{{borealisId}}/tasks
  body: none
  auth: none
}

headers {
  X-User: alice
  X-Grants: task:read@region=emea
}

assert {
  res.status: eq 200
  res.body.data: isArray
}

tests {
  test("Tasks under a project outside access are not listed", function() {
    expect(res.body.data.length).to.equal(0);
  });
}
