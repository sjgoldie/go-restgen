meta {
  name: Create Order - Alice (APAC)
  type: http
  seq: 20
}

post {
  url: {{baseUrl}}/orders
  body: json
  auth: none
}

headers {
  X-User: alice
  X-Scopes: order:read
}

body:json {
  {
    "region": "apac",
    "title": "Laptop"
  }
}

assert {
  res.status: eq 201
  res.body.customer_id: eq alice
}
