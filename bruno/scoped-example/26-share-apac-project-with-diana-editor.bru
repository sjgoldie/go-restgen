meta {
  name: Share APAC Project With Diana - Editor
  type: http
  seq: 26
}

post {
  url: {{baseUrl}}/project-shares
  body: json
  auth: none
}

headers {
  X-User: admin
  X-Scopes: project:share
}

body:json {
  {
    "project_id": {{borealisId}},
    "user_id": "diana",
    "level": "editor"
  }
}

assert {
  res.status: eq 201
  res.body.level: eq editor
}
