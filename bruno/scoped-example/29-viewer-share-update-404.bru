meta {
  name: Update Shared Project - Viewer Gets 404
  type: http
  seq: 29
}

patch {
  url: {{baseUrl}}/projects/{{borealisId}}
  body: json
  auth: none
}

headers {
  X-User: bob
  X-Grants: project:read@region=;project:write@region=
}

body:json {
  {
    "name": "Borealis (edited by Bob)"
  }
}

assert {
  res.status: eq 404
}

docs {
  # Levels Per Method
  Updates accept only editor shares, so a viewer share does not reach the project.
}
