meta {
  name: Create Task in Shared Project - Editor
  type: http
  seq: 34
}

post {
  url: {{baseUrl}}/projects/{{borealisId}}/tasks
  body: json
  auth: none
}

headers {
  X-User: diana
  X-Grants: task:write@region=
}

body:json {
  {
    "title": "Diana's task"
  }
}

assert {
  res.status: eq 201
}
