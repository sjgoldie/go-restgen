meta {
  name: Create Assessment Under EMEA Project
  type: http
  seq: 36
}

post {
  url: {{baseUrl}}/assessments
  body: json
  auth: none
}

headers {
  X-User: alice
  X-Grants: assessment:write@region=emea
}

body:json {
  {
    "project_id": {{apolloId}},
    "title": "Apollo review"
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
}

script:post-response {
  bru.setVar("apolloAssessmentId", res.body.id);
}

tests {
  test("Assessment is created under the EMEA project", function() {
    expect(res.body.project_id).to.equal(bru.getVar("apolloId"));
  });
}

docs {
  # Partition Through a Relation
  Assessments are a top-level route with no region field. The route declares
  WithPartition("region", "Project.Region"), so an assessment is in EMEA because the project
  it references is. Alice's EMEA grant covers Apollo, so the create succeeds.
}
