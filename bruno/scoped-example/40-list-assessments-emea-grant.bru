meta {
  name: List Assessments - EMEA Grant
  type: http
  seq: 40
}

get {
  url: {{baseUrl}}/assessments
  body: none
  auth: none
}

headers {
  X-User: alice
  X-Grants: assessment:read@region=emea
}

assert {
  res.status: eq 200
  res.body.data: isArray
}

tests {
  test("Only assessments of EMEA projects are listed", function() {
    expect(res.body.data.length).to.equal(1);
    expect(res.body.data[0].id).to.equal(bru.getVar("apolloAssessmentId"));
  });
}
