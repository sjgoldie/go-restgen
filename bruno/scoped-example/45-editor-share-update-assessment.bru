meta {
  name: Update Shared Assessment - Editor
  type: http
  seq: 45
}

patch {
  url: {{baseUrl}}/assessments/{{borealisAssessmentId}}
  body: json
  auth: none
}

headers {
  X-User: diana
  X-Grants: assessment:write@region=
}

body:json {
  {
    "title": "Diana's edit"
  }
}

assert {
  res.status: eq 200
}

tests {
  test("The editor share updates the assessment", function() {
    expect(res.body.title).to.equal("Diana's edit");
  });
}
