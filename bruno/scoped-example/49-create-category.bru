meta {
  name: Create Category
  type: http
  seq: 49
}

post {
  url: {{baseUrl}}/categories
  body: json
  auth: none
}

headers {
  X-User: admin
  X-Scopes: category:write
}

body:json {
  {
    "name": "Research"
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
}

script:post-response {
  bru.setVar("categoryId", res.body.id);
}
